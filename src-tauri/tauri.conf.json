{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StS2 Callout",
  "version": "0.1.0",
  "identifier": "dev.sts2callout.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "StS2 Callout",
        "url": "index.html",
        "width": 820,
        "height": 760,
        "minWidth": 560,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "StS2 Callout Overlay",
        "url": "overlay.html",
        "width": 700,
        "height": 900,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: stsimg: http://stsimg.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.6"
    }
  }
}
